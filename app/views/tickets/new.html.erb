<% content_for :title, "Novo chamado · Triagem" %>

<% if flash[:alert] %>
  <div class="mb-6 rounded-xl border border-rose-200 dark:border-rose-500/30 bg-rose-50 dark:bg-rose-500/10 px-4 py-3 text-sm text-rose-800 dark:text-rose-300" role="alert">
    <%= flash[:alert] %>
  </div>
<% end %>

<div class="mb-8">
  <h1 class="text-3xl font-semibold tracking-tight">Novo chamado</h1>
  <p class="mt-2 text-slate-600 dark:text-slate-400">
    Cole a mensagem do cliente. O Jev escolhe o time, sinaliza a urgência e avalia a gravidade.
  </p>
</div>

<%= form_with url: tickets_path, class: "rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-6 shadow-sm" do |form| %>
  <%= form.label :body, "Mensagem", class: "block text-sm font-medium text-slate-700 dark:text-slate-300" %>
  <%= form.text_area :body,
        value: @body,
        rows: 8,
        required: true,
        placeholder: "Ex.: O checkout está falhando para todos os nossos clientes desde as 9h e estamos perdendo vendas.",
        class: "mt-2 block w-full resize-y rounded-xl border border-slate-300 dark:border-slate-700 px-4 py-3 text-slate-900 dark:text-slate-100 " \
               "placeholder:text-slate-400 dark:placeholder:text-slate-500 focus:border-indigo-500 focus:ring-4 focus:ring-indigo-100 dark:focus:ring-indigo-500/20 focus:outline-none" %>

  <fieldset class="mt-6">
    <legend class="text-sm font-medium text-slate-700 dark:text-slate-300">Rigor da triagem</legend>
    <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">
      Confiança mínima que cada resposta precisa ter. Abaixo dela, o chamado vai para revisão humana.
    </p>
    <div class="mt-3 grid gap-3 sm:grid-cols-3">
      <% [
           [ nil,  "Padrão",        "Mínimo definido por pergunta" ],
           [ 0.9,  "Rigoroso",      "90% em todas as perguntas" ],
           [ 0.95, "Muito rigoroso", "95% em todas as perguntas" ]
         ].each do |value, title, hint| %>
        <label class="flex cursor-pointer flex-col rounded-xl border border-slate-300 dark:border-slate-700 px-4 py-3 text-sm hover:bg-slate-50 dark:hover:bg-slate-800
                      has-checked:border-indigo-500 has-checked:bg-indigo-50 dark:has-checked:bg-indigo-500/10 has-checked:ring-2 has-checked:ring-indigo-100 dark:has-checked:ring-indigo-500/20">
          <span class="flex items-center gap-2 font-medium text-slate-900 dark:text-slate-100">
            <%= form.radio_button :strictness, value.to_s, checked: @strictness == value, class: "accent-indigo-600" %>
            <%= title %>
          </span>
          <span class="mt-1 text-xs text-slate-500 dark:text-slate-400"><%= hint %></span>
        </label>
      <% end %>
    </div>
  </fieldset>

  <div class="mt-6 flex items-center justify-end">
    <%= form.submit "Fazer triagem",
          data: { turbo_submits_with: "Analisando…" },
          class: "cursor-pointer rounded-xl bg-indigo-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm " \
                 "hover:bg-indigo-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600 " \
                 "disabled:cursor-wait disabled:opacity-60" %>
  </div>
<% end %>
